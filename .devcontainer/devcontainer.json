{
  "name": "Codex Sandbox",
  "dockerComposeFile": "docker-compose.yml",
  "service": "codex-sandbox",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "npm install",
  "waitFor": "postCreateCommand",
  "customizations": {
    "vscode": {
      "settings": {},
      "extensions": ["openai.chatgpt"]
    }
  },
  "shutdownAction": "stopCompose"
}
