{
  "name": "miniapp-specifications",
  "private": true,
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "format:md": "prettier --write \"**/*.md\"",
    "check:md": "prettier --check \"**/*.md\"",
    "prepare": "husky",
    "security:review": "python3 scripts/security-review.py",
    "test:tooling": "python3 -m unittest discover -s tests/tooling -v"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9"
  },
  "lint-staged": {
    "**/*.md": "prettier --write"
  }
}
