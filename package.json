{
  "name": "member-miniapps",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "format:md": "prettier --write \"**/*.md\"",
    "check:md": "prettier --check \"**/*.md\"",
    "prepare": "husky",
    "security:review": "python3 scripts/security-review.py",
    "test:tooling": "python3 -m unittest discover -s tests/tooling -v",
    "dev": "next dev web",
    "start": "next start web",
    "build": "next build web",
    "typecheck": "npm run typecheck:web && npm run typecheck:gas",
    "typecheck:web": "tsc --noEmit -p tsconfig.json",
    "typecheck:gas": "tsc --noEmit -p gas/backup/tsconfig.json",
    "lint": "eslint web gas/backup/src gas/backup/tests tests/integration scripts/gas-check-upload.mjs vitest.config.ts eslint.config.mjs",
    "lint:gas": "eslint gas/backup/src gas/backup/tests",
    "test:gas": "vitest run gas/backup/tests",
    "gas:check-files": "npx --yes --package=@google/clasp@3.4.1 node scripts/gas-check-upload.mjs",
    "gas:login": "npx --yes @google/clasp@3.4.1 login",
    "gas:status": "cd gas/backup && npx --yes @google/clasp@3.4.1 show-file-status",
    "gas:push": "npm run gas:check-files && npm run typecheck:gas && npm run lint:gas && npm run test:gas && cd gas/backup && npx --yes @google/clasp@3.4.1 push",
    "test": "vitest run",
    "test:smoke": "node tests/integration/web-runtime-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/google-apps-script": "2.0.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "lint-staged": {
    "**/*.md": "prettier --write"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "version": "0.1.0"
}
