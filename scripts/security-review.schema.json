{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "snapshot_sha256",
    "skill_sha256",
    "findings",
    "notes"
  ],
  "properties": {
    "status": { "type": "string", "enum": ["pass", "block", "incomplete"] },
    "snapshot_sha256": { "type": "string" },
    "skill_sha256": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "location", "reason", "fix"],
        "properties": {
          "severity": { "type": "string", "enum": ["high", "medium", "low"] },
          "location": { "type": "string" },
          "reason": { "type": "string" },
          "fix": { "type": "string" }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
